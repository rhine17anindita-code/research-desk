# Research Desk — copy to .env.local and fill in what you need.
# Everything except AI generation works with this file left empty.

# --- AI provider (optional) -------------------------------------------------
# Anthropic (Claude). Keys stay on the server; they are never sent to the browser.
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter, OpenAI...).
# Select "openai_compatible" as the provider in Settings → AI to use it.
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=

# --- Storage ----------------------------------------------------------------
# SQLite file location (default: ./data/research-desk.db)
DATABASE_PATH=

# --- Background ingestion -----------------------------------------------------
# Minutes between automatic feed refreshes while the server runs. 0 / empty = manual only.
INGEST_INTERVAL_MINUTES=0

# --- Research retrieval -------------------------------------------------------
# Optional contact address for OpenAlex's "polite pool" (faster, more reliable).
# Leave empty to make anonymous requests.
OPENALEX_MAILTO=

# --- Access (required when deployed) ----------------------------------------
# Site password. When set, every page and API needs sign-in. In production the
# site refuses to run without it unless ALLOW_OPEN_ACCESS=true.
SITE_PASSWORD=
# Optional: separate secret for signing sessions (changing it signs everyone out).
SESSION_SECRET=
ALLOW_OPEN_ACCESS=false
