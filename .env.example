# Research Desk — copy to .env.local (or set these in your host's environment variables).
# Only SITE_PASSWORD is needed for a deployed site; everything else is optional.

# Site password. Required in production: the site stays locked without it.
SITE_PASSWORD=

# Enables AI features (Claude). Keys stay on the server, never in the browser.
ANTHROPIC_API_KEY=

# Refresh feeds automatically every N minutes while the server runs (0 = manual only).
INGEST_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Optional — uncomment only if you need them.
# ---------------------------------------------------------------------------
# Free YouTube Data API key (Google Cloud console) to show related videos inside the app.
# YOUTUBE_API_KEY=
# Separate secret for signing sessions (changing it signs everyone out).
# SESSION_SECRET=
# Run in production without a password (not recommended).
# ALLOW_OPEN_ACCESS=false
# SQLite file location. Default: ./data/research-desk.db locally, ~/research-desk-data/ on hosts
# that rebuild the app folder on deploy (e.g. Hostinger).
# DATABASE_PATH=
# Any OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter…); select it in Settings → AI.
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# Contact address for OpenAlex's faster "polite pool"; empty = anonymous requests.
# OPENALEX_MAILTO=
